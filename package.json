{
	"name": "monorepo-starter",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"dev:stop": "turbo run dev:stop",
		"lint": "turbo run check:lint",
		"test": "turbo run test",
		"test:watch": "turbo run test:watch",
		"test:coverage": "turbo run test:coverage",
		"test:integration": "turbo run test:integration",
		"generate:bin:bash": "turbo gen bin --args -- _ bash",
		"generate:bin:ts": "turbo gen bin --args _ typescript",
		"generate:package": "turbo gen package",
		"format": "prettier --write --log-level warn \"**/*.{js,jsx,ts,tsx,md,css,scss,json,yaml,yml}\"",
		"check": "pnpm run \"/^check:.*/\"",
		"check:format": "prettier --check \"**/*.{js,jsx,ts,tsx,md,css,scss,json,yaml,yml}\"",
		"check:lint": "turbo run check:lint",
		"check:types": "turbo run check:types",
		"alert": "printf \"\\aClaude is done!\\n\""
	},
	"devDependencies": {
		"@turbo/gen": "^2.9.6",
		"npm-run-all": "^4.1.5",
		"@types/node": "^24.1.0",
		"@vitest/coverage-v8": "^4.1.5",
		"@vitest/ui": "^4.1.5",
		"prettier": "^3.8.3",
		"turbo": "^2.9.6",
		"typescript": "^6.0.0",
		"vitest": "^4.1.5"
	},
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"tsx": "^4.21.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"sharp"
		],
		"overrides": {
			"kysely-codegen>better-sqlite3": "12.0.0",
			"@types/react": "19.2.14",
			"@types/react-dom": "19.2.3"
		}
	}
}
