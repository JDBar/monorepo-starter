{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "out/**", "dist/**"]
		},
		"check:lint": {
			"dependsOn": ["^check:lint"]
		},
		"check:types": {
			"dependsOn": ["^check:types"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},
		"test:integration": {
			"dependsOn": ["build"]
		},
		"test:coverage": {
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:stop": {
			"cache": false
		}
	}
}
