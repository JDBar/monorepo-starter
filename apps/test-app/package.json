{
	"name": "test-app",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "pnpm dev:stop && run-p dev:next dev:tsm",
		"dev:next": "next dev --port 3000",
		"dev:tsm": "typed-scss-modules --watch .",
		"dev:stop": "pkill -f '[n]ext dev --port 3000' 2>/dev/null; pkill -f '[t]yped-scss-modules' 2>/dev/null; exit 0",
		"build": "next build",
		"start": "pnpm serve out",
		"check": "pnpm run \"/^check:.*/\"",
		"check:lint": "eslint . --max-warnings 0",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@repo/ui": "workspace:*",
		"next": "16.2.4",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"sass": "^1.99.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.1.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"eslint": "^9.28.0",
		"serve": "^14.2.6",
		"typed-scss-modules": "^8.1.1",
		"typescript": "^6.0.0"
	}
}
